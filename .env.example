# Cognito User Pool (frontend SPA client — sem secret).
# Deixe vazios para rodar em modo DEV com mock user (devLogin).
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxx

# URL base da zoe-api (sem barra final).
# Em dev local típico: http://localhost:5XXX
VITE_API_BASE_URL=https://api.dev.heyzoe.com.br
